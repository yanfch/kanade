{
	"name": "kanade",
	"version": "0.0.1",
	"private": true,
	"description": "Multi-agent workflow runtime. LLM writes scripts, you save the good ones.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yanfch/kanade.git"
	},
	"bugs": {
		"url": "https://github.com/yanfch/kanade/issues"
	},
	"homepage": "https://github.com/yanfch/kanade#readme",
	"keywords": [
		"ai",
		"agents",
		"workflow",
		"coding-agent",
		"automation"
	],
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"kanade": "./src/bin/kanade.ts"
	},
	"scripts": {
		"dev": "tsx watch src/bin/server.ts",
		"start": "tsx src/bin/server.ts",
		"cli": "tsx src/bin/kanade.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"eval": "tsx eval/run.ts --mock",
		"eval:author": "tsx eval/workflow-author/run.ts",
		"eval:workflow-author": "tsx eval/workflow-author/run.ts",
		"live:accept": "tsx scripts/live-acceptance.ts",
		"smoke:pi-kanade": "tsx scripts/smoke-pi-kanade.ts",
		"smoke:generated-workflow": "tsx scripts/generated-workflow-smoke.ts",
		"smoke:generated-live": "tsx scripts/generated-live-smoke.ts",
		"smoke:workflow-promotion": "tsx scripts/workflow-promotion-smoke.ts",
		"lint": "biome check src/ scripts/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^0.79.1",
		"@earendil-works/pi-coding-agent": "^0.79.1",
		"@earendil-works/pi-tui": "^0.79.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.219.0",
		"@opentelemetry/core": "^2.8.0",
		"@opentelemetry/resources": "^2.8.0",
		"@opentelemetry/sdk-logs": "^0.219.0",
		"@opentelemetry/sdk-metrics": "^2.8.0",
		"@opentelemetry/sdk-trace-base": "^2.8.0",
		"@opentelemetry/semantic-conventions": "^1.41.1",
		"acorn": "^8.14.0",
		"better-sqlite3": "^11.7.0",
		"hono": "^4.6.0",
		"picocolors": "^1.1.1",
		"simple-git": "^3.27.0",
		"typebox": "^1.1.0",
		"undici": "^8.3.0",
		"yaml": "^2.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@hono/node-server": "^1.13.0",
		"@types/better-sqlite3": "^7.6.0",
		"@types/node": "^22.10.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^4.1.9"
	},
	"lint-staged": {
		"*.ts": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
